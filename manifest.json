{
  "manifest_version": 3,
  "name": "Export Tabs as Markdown",
  "version": "1.0.0",
  "permissions": ["tabs"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_title": "Export tabs as Markdown"
  }
}
